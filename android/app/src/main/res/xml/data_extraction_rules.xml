<?xml version="1.0" encoding="utf-8"?>
<!--
    Veloce stores VPN connection configurations (including server credentials)
    in app-private storage. Never let Android cloud backup or device-to-device
    transfer copy that data off the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
